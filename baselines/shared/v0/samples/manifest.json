{
  "name": "skillforge-shared-samples",
  "protocol": "shared-sample.v0",
  "version": "v0",
  "root": "baselines/shared/v0/samples",
  "files": [
    {
      "dataset": "betterprompt",
      "path": "betterprompt.jsonl",
      "count": 4
    },
    {
      "dataset": "betterplan",
      "path": "betterplan.jsonl",
