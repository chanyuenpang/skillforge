{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workflow-kit.local/skillforge/replay-eval-contract.schema.json",
  "title": "Skillforge Minimal Replay Eval Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "pass_rule", "match_strategy", "samples", "results"],
  "properties": {
    "version": {
      "type": "string",
      "const": "replay-eval-contract.v1"
    },
    "pass_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_pass", "overall_min_pass_rate"],
      "properties": {
        "sample_pass": {
          "type": "string",
          "const": "pass == true"
        },
        "overall_min_pass_rate": {
          "type": "number",
          "const": 1
        }
      }
    },
    "match_strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["string", "structured"],
      "properties": {
        "string": {
          "type": "string",
          "const": "normalized_exact"
        },
        "structured": {
          "type": "string",
          "const": "field_exact"
        }
      }
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sample" }
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/result" }
    }
  },
  "$defs": {
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_id", "input", "expected", "tags"],
      "properties": {
        "sample_id": { "type": "string", "minLength": 1 },
        "input": {
          "oneOf": [
            { "type": "string" },
            { "type": "object", "additionalProperties": true }
          ]
        },
        "expected": {
          "oneOf": [
            { "type": "string" },
            { "type": "object", "additionalProperties": true }
          ]
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_id", "actual", "pass", "score", "reason"],
      "properties": {
        "sample_id": { "type": "string", "minLength": 1 },
        "actual": {
          "oneOf": [
            { "type": "string" },
            { "type": "object", "additionalProperties": true }
          ]
        },
        "pass": { "type": "boolean" },
        "score": { "type": "number" },
        "reason": { "type": "string" }
      }
    }
  }
}
