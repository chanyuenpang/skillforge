function testTranscriptAvailabilitySkeletonConstants() {
  assert.equal(RUNTIME_TRANSCRIPT_AVAILABILITY_SKELETON_VERSION, "runtime-transcript-availability-skeleton-draft-1");
  assert.equal(RUNTIME_PROVIDER_EXECUTION_IDENTITY_KIND, "runtime-provider-execution-identity");
