/* ───────── Provider adapter buildRuntimeProviderTranscriptRef direct ───────── */

function testBuildRuntimeProviderTranscriptRefBoundaries() {
  const defaultRef = buildRuntimeProviderTranscriptRef({});
  assert.equal(defaultRef.available, false);
  assert.equal(defaultRef.providerManaged, false);
  assert.equal(defaultRef.providerTranscript, false);
  assert.equal(defaultRef.handle, null);
  assert.equal(defaultRef.persistence, "none");

  const reservedRef = buildRuntimeProviderTranscriptRef({
    handle: "my-handle",
    available: true,
    providerManaged: true,
    persistence: "reserved-provider-managed",
    location: { kind: "provider-artifact", path: ["remote", "artifact"] },
  });

  assert.equal(reservedRef.available, true);
  assert.equal(reservedRef.providerManaged, true);
  assert.equal(reservedRef.providerTranscript, true);
  assert.equal(reservedRef.handle, "my-handle");
  assert.equal(reservedRef.persistence, "reserved-provider-managed");
  assert.deepEqual(reservedRef.location, { kind: "provider-artifact", path: ["remote", "artifact"] });
  assert.match(reservedRef.note, /no provider transcript capture/i);

  const availableNotManaged = buildRuntimeProviderTranscriptRef({
    handle: "orphan-handle",
    available: true,
    providerManaged: false,
  });
  assert.equal(availableNotManaged.handle, null, "non-providerManaged transcriptRef must strip handle");
  assert.equal(availableNotManaged.providerTranscript, false);
  assert.equal(availableNotManaged.persistence, "none");
}

function testBuildRuntimeProviderTranscriptRefRejectsInvalidPersistence() {
  assert.throws(
    () =>
      buildRuntimeProviderTranscriptRef({
        available: true,
        providerManaged: true,
        persistence: "invalid-persistence-mode",
      }),
    /Unsupported runtime provider transcript ref persistence mode/i,
  );
}

function testProviderAdapterTranscriptRefPersistenceConstants() {
  assert.deepEqual(RUNTIME_PROVIDER_TRANSCRIPT_REF_PERSISTENCE_MODES, ["none", "reserved-provider-managed"]);
  assert.equal(RUNTIME_PROVIDER_TRANSCRIPT_REF_RESERVED_HANDLE_PREFIX, "reserved:provider-transcript:");
  assert.deepEqual(RUNTIME_PROVIDER_RAW_RESPONSE_CAPTURE_MODES, ["none", "summary-only"]);
  assert.equal(RUNTIME_PROVIDER_RAW_RESPONSE_KIND, "runtime-provider-raw-response");
  assert.deepEqual(RUNTIME_PROVIDER_EXECUTION_IDENTITY_STATUS_SET, ["stub-reserved", "stub-blocked", "stub-error"]);
  assert.deepEqual(RUNTIME_PROVIDER_ADAPTER_RESERVED_STATUS_SET, ["blocked", "error", "dry-run", "not-executed"]);
  assert.ok(RUNTIME_PROVIDER_ADAPTER_FUTURE_REQUIRED_FIELDS.length > 10);
}

