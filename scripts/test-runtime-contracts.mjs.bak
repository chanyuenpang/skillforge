              providerManaged: false,
              handle: null,
              location: null,
              providerBacked: true,
              transcriptCaptured: false,
              transcriptPersistence: false,
              persistence: "none",
            },
            failureReason: {
              code: "RUNTIME_PROVIDER_ADAPTER_UNIMPLEMENTED",
              message: "unimplemented",
              sourceStatus: "blocked",
              sameSource: true,
              providerBackedReserved: true,
            },
          },
        ],
      }),
    /failureReason sourceStatus must match case status/i,
  );
}

function testFailureReasonSemanticsAreStampedFromSameSourceStatus() {
  const normalizedFixture = createNormalizedFixture();
  const caseRecord = selectRuntimeCase({ normalizedFixture });

  const blockedMapped = mapProviderResultToObservedRuntime({
    adapterResult: {
      caseId: caseRecord.id,
      status: "blocked",
      failureReason: {
        code: "RUNTIME_PREFLIGHT_BLOCKED",
        message: "blocked by preflight",
        blockingCheckIds: ["RF-P1-PREFLIGHT-STATIC-BASELINE-PASSED"],
        sourceStatus: "error",
        sameSource: false,
        providerBackedReserved: true,
      },
      providerMetadata: {
        implementationState: "preflight-blocked",
        executed: false,
        providerCall: false,
        providerEvidenceAvailable: false,
        transcriptCaptured: false,
        transcriptPersistence: false,
        persistence: "none",
      },
    },
    providerSelection: {
      adapterKey: "dry-run",
      providerKey: "dry-run",
      providerSlot: RUNTIME_PROVIDER_ADAPTER_DEFAULT_SLOT,
      builtin: true,
      implemented: true,
      providerBacked: false,
    },
    caseContext: caseRecord,
  });

  assert.equal(blockedMapped.failureReason.sourceStatus, "blocked");
  assert.equal(blockedMapped.failureReason.sameSource, true);
  assert.equal(blockedMapped.failureReason.providerBackedReserved, false);

  const providerBackedErrorMapped = mapProviderResultToObservedRuntime({
    adapterResult: {
      caseId: caseRecord.id,
      status: "error",
      failureReason: {
        code: "RUNTIME_PROVIDER_ADAPTER_UNIMPLEMENTED",
        message: "reserved slot",
        sourceStatus: "blocked",
        sameSource: false,
        providerBackedReserved: false,
      },
      providerMetadata: {
        implementationState: "reserved-unimplemented-provider-slot",
        executed: false,
        providerCall: false,
        providerEvidenceAvailable: false,
        transcriptCaptured: false,
        transcriptPersistence: false,
        persistence: "none",
      },
    },
    providerSelection: {
      adapterKey: "provider-backed",
      providerKey: "provider-backed",
      providerSlot: RUNTIME_PROVIDER_ADAPTER_DEFAULT_SLOT,
      builtin: true,
      implemented: false,
      providerBacked: true,
    },
    caseContext: caseRecord,
  });

  assert.equal(providerBackedErrorMapped.failureReason.sourceStatus, "error");
  assert.equal(providerBackedErrorMapped.failureReason.sameSource, true);
  assert.equal(providerBackedErrorMapped.failureReason.providerBackedReserved, true);
}

/* ───────── Transcript artifact direct contract tests ───────── */

function testTranscriptArtifactContractShape() {
  const fixture = {
    id: "test-fixture",
    version: "1.0.0",
    entry: "skill/SKILL.md",
    profile: "standard",
  };
  const caseRecord = { id: "case-01", type: "positive", intent: "test intent", expectedBehavior: ["does something"] };

  const artifact = buildRuntimeTranscriptArtifact({
    fixture: { fixtureDir: "/tmp", ...fixture },
    caseRecord,
    executionMode: "dry-run",
    boundary: null,
    runnerMetadata: null,
    outcome: null,
    events: [],
  });

  assert.equal(artifact.kind, RUNTIME_TRANSCRIPT_ARTIFACT_KIND);
  assert.equal(artifact.artifactVersion, RUNTIME_TRANSCRIPT_ARTIFACT_CONTRACT_VERSION);
  assert.equal(artifact.scope, RUNTIME_TRANSCRIPT_ARTIFACT_SCOPE);
  assert.equal(artifact.scope, "single-case");
  assert.equal(artifact.executionClass, RUNTIME_TRANSCRIPT_ARTIFACT_EXECUTION_CLASS);
  assert.equal(artifact.executionClass, "provider-less-draft-only");
  assert.equal(artifact.evidenceClass, RUNTIME_TRANSCRIPT_ARTIFACT_EVIDENCE_CLASS);
  assert.equal(artifact.evidenceClass, "orchestration-stub");
  assert.equal(artifact.refScheme, RUNTIME_TRANSCRIPT_ARTIFACT_REF_SCHEME);
  assert.equal(artifact.refScheme, "in-report-draft-artifact-ref");
  assert.equal(artifact.artifactId, "draft:test-fixture:case-01:dry-run");
  assert.match(artifact.note, /orchestration evidence/i);
  assert.match(artifact.note, /no model dialogue/i);

  const expectedCaps = ["provider-transcript", "transcript-persistence", "transcript-ref-wiring", "sandbox-implementation", "scoring-engine"];
  for (const cap of expectedCaps) {
    assert.ok(artifact.pendingCapabilities.includes(cap), `artifact pendingCapabilities must include ${cap}`);
  }

  assert.equal(artifact.runnerMetadata.transcriptEngineUsed, false);
  assert.equal(artifact.outcome.transcriptCaptured, false);
  assert.equal(artifact.outcome.providerResponseCaptured, false);
  assert.equal(artifact.outcome.persistence, "in-report-only");
  assert.ok(Array.isArray(artifact.events));
}

function testTranscriptArtifactExecutionClassStaysProviderLessEvenForProviderBacked() {
  const fixture = { id: "test-fixture", version: "1.0.0", entry: "skill/SKILL.md", profile: "standard" };
  const caseRecord = { id: "case-01", type: "positive" };

  const artifact = buildRuntimeTranscriptArtifact({
    fixture: { fixtureDir: "/tmp", ...fixture },
    caseRecord,
    executionMode: "provider-backed",
    boundary: null,
    runnerMetadata: { mode: "provider-backed", providerBacked: true },
    outcome: null,
    events: [],
  });

  assert.equal(artifact.executionClass, RUNTIME_TRANSCRIPT_ARTIFACT_EXECUTION_CLASS);
  assert.equal(artifact.executionClass, "provider-less-draft-only");
  assert.equal(artifact.evidenceClass, RUNTIME_TRANSCRIPT_ARTIFACT_EVIDENCE_CLASS);
  assert.equal(artifact.evidenceClass, "orchestration-stub");
  assert.equal(artifact.executionMode, "provider-backed");
  assert.match(artifact.note, /orchestration evidence/i);
  assert.match(artifact.note, /no model dialogue/i);
  assert.equal(artifact.runnerMetadata.providerCall, false);
  assert.equal(artifact.outcome.transcriptCaptured, false);
  assert.equal(artifact.outcome.providerResponseCaptured, false);
}

function testTranscriptArtifactRefContractDefaults() {
  const ref = buildRuntimeTranscriptArtifactRef({});

  assert.equal(ref.kind, RUNTIME_TRANSCRIPT_ARTIFACT_REF_KIND);
  assert.equal(ref.version, RUNTIME_TRANSCRIPT_ARTIFACT_REF_VERSION);
  assert.equal(ref.available, false);
  assert.equal(ref.providerTranscript, false);
  assert.equal(ref.persistence, "in-report-only");
  assert.equal(ref.caseId, null);
  assert.equal(ref.executionMode, null);
  assert.match(ref.note, /not a provider transcript reference/i);

  const refWithCase = buildRuntimeTranscriptArtifactRef({
    artifactId: "draft:fixture:case:mode",
    caseId: "case-01",
    executionMode: "dry-run",
    available: true,
    persistence: "in-report-only",
    providerTranscript: false,
  });

  assert.equal(refWithCase.available, true);
  assert.equal(refWithCase.providerTranscript, false);
  assert.equal(refWithCase.artifactId, "draft:fixture:case:mode");
  assert.equal(refWithCase.caseId, "case-01");
  assert.equal(refWithCase.executionMode, "dry-run");
  assert.equal(refWithCase.persistence, "in-report-only");
}

/* ───────── Runner contract transcript ref scrubbing ───────── */

function testRunnerResultRejectsProviderTranscriptOrProviderManagedForNonProviderBacked() {
  const normalizedFixture = createNormalizedFixture();
  const caseRecord = selectRuntimeCase({ normalizedFixture });

  const runnerMetadata = { providerBacked: false, executed: false, providerCall: false };

  assert.throws(
    () =>
      buildRuntimeRunnerResult({
        caseId: caseRecord.id,
        status: "dry-run",
        runnerMetadata,
        transcriptRef: { available: true, providerTranscript: true, handle: "fake", persistence: "reserved-provider-managed" },
      }),
    /Provider transcript refs are reserved until provider-backed runtime execution/i,
  );

  assert.throws(
    () =>
      buildRuntimeRunnerResult({
        caseId: caseRecord.id,
        status: "dry-run",
        runnerMetadata,
        transcriptRef: { available: true, providerManaged: true, handle: "fake", persistence: "reserved-provider-managed" },
      }),
    /Provider-managed transcript refs are reserved for provider-backed runtime execution/i,
  );
}

function testRunnerResultScrubsTranscriptRefFieldsForNonProviderBacked() {
  const normalizedFixture = createNormalizedFixture();
  const caseRecord = selectRuntimeCase({ normalizedFixture });

  const result = buildRuntimeRunnerResult({
    caseId: caseRecord.id,
    status: "dry-run",
    runnerMetadata: { providerBacked: false, executed: false, providerCall: false },
    transcriptRef: {
      available: true,
      providerTranscript: false,
      providerManaged: false,
      handle: "some-handle",
      location: { kind: "external", path: ["artifact"] },
      persistence: "in-report-only",
    },
  });

  assert.ok(result.transcriptRef != null);
  assert.equal(result.transcriptRef.available, false, "non-provider-backed transcriptRef.available must be forced to false");
  assert.equal(result.transcriptRef.providerTranscript, false);
  assert.equal(result.transcriptRef.providerManaged, false);
  assert.equal(result.transcriptRef.handle, null);
  assert.equal(result.transcriptRef.location, null);
  assert.equal(result.transcriptRef.persistence, "none");
}

/* ───────── Runner contract failure taxonomy ───────── */

function testRunnerResultForbidsExecutedAndProviderCallForProviderBackedReserved() {
  const normalizedFixture = createNormalizedFixture();
  const caseRecord = selectRuntimeCase({ normalizedFixture });

  assert.throws(
    () =>
      buildRuntimeRunnerResult({
        caseId: caseRecord.id,
        status: "blocked",
        runnerMetadata: { providerBacked: true, executed: true },
      }),
    /provider-backed reserved seam forbids executed=true/i,
  );

  assert.throws(
    () =>
      buildRuntimeRunnerResult({
        caseId: caseRecord.id,
        status: "error",
        runnerMetadata: { providerBacked: true, providerCall: true },
      }),
    /provider-backed reserved seam forbids providerCall=true/i,
  );
}

