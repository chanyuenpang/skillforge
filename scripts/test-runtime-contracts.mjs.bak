function testProviderAdapterOutputSkeletonStaysConservative() {
  const normalizedFixture = createNormalizedFixture();
  const loadedFixture = createLoadedFixture();
  const preflightReport = createPreflightReport("passed");
  const sandboxContract = buildRuntimeSandboxBoundaryFromSources({
    normalizedFixture,
    preflightInput: preflightReport,
  });
  const caseRecord = selectRuntimeCase({ normalizedFixture });
  const providerAdapterContract = buildRuntimeProviderAdapterContractContext({
    fixtureDir: "/tmp/runtime-contract-fixture",
    loadedFixture,
    normalizedFixture,
    caseRecord,
    boundary: {
      permissions: sandboxContract.permissions,
      toolBoundary: sandboxContract.toolBoundary,
    },
    options: {
      mode: "provider-backed",
      providerKey: "provider-backed",
      providerSlot: RUNTIME_PROVIDER_ADAPTER_DEFAULT_SLOT,
      providerSelection: buildRuntimeProviderSelection({
        mode: "provider-backed",
        providerSlot: RUNTIME_PROVIDER_ADAPTER_DEFAULT_SLOT,
      }),
    },
  });

  const adapterResult = providerAdapterContract.buildResult({
    caseId: caseRecord.id,
    status: "error",
    providerMetadata: {
      implementationState: "reserved-unimplemented-provider-slot",
      providerBacked: true,
      providerKey: "provider-backed",
      providerSlot: RUNTIME_PROVIDER_ADAPTER_DEFAULT_SLOT,
    },
  });

  assert.equal(adapterResult.contract.kind, "runtime-provider-adapter-output");
  assert.ok(adapterResult.contract.version);

  /* Provider-backed reserved seam selection: implementation preserves the actual selection,
     not a downgraded dry-run.  Conservative behavior is enforced through evidence/execution fields. */
  assert.equal(adapterResult.selection.adapterKey, "provider-backed");
  assert.equal(adapterResult.selection.providerKey, "provider-backed");
  assert.equal(adapterResult.selection.implemented, false);
  assert.equal(adapterResult.selection.providerBacked, true);
  assert.equal(adapterResult.selection.builtin, true);
  assert.equal(adapterResult.selection.kind, "runtime-provider-selection");

  /* Execution conservatively reports stub execution identity for provider-backed error status */
  assert.equal(adapterResult.execution.executed, false);
  assert.equal(adapterResult.execution.providerCall, false);
  assert.ok(typeof adapterResult.execution.executionId === "string");
  assert.match(adapterResult.execution.executionId, /^stub:/);
  assert.ok(typeof adapterResult.execution.providerRunId === "string");
  assert.match(adapterResult.execution.providerRunId, /^stub-run:/);
  assert.equal(adapterResult.execution.providerStatus, "stub-reserved");
  assert.equal(adapterResult.execution.identityKind, "runtime-provider-execution-identity");
  assert.equal(adapterResult.execution.identityVersion, "runtime-provider-execution-identity-stub-draft-1");

  assert.deepEqual(adapterResult.evidence, {
    providerEvidenceAvailable: false,
    transcriptAvailability: "none",
    transcriptAvailable: false,
    transcriptCaptured: false,
    transcriptPersistence: false,
    persistence: "none",
    preflightBlocked: false,
  });
  assert.deepEqual(adapterResult.rawResponse, {
    kind: "runtime-provider-raw-response",
    version: "runtime-provider-raw-response-draft-1",
    available: false,
    captureMode: "none",
    summary: null,
    handle: null,
    note:
      "reserved provider-backed raw response evidence slot only; no provider payload capture, transcript capture, or persistence is implemented in this phase",
  });

  /* Provider-backed reserved seam: providerMetadata reflects conservative state with stub identity */
  assert.equal(adapterResult.providerMetadata.providerBacked, true);
  assert.equal(adapterResult.providerMetadata.adapterKey, "provider-backed");
  assert.equal(adapterResult.providerMetadata.providerKey, "provider-backed");
  assert.equal(adapterResult.providerMetadata.executed, false);
  assert.equal(adapterResult.providerMetadata.providerCall, false);
  assert.equal(adapterResult.providerMetadata.providerEvidenceAvailable, false);
  assert.equal(adapterResult.providerMetadata.transcriptAvailable, false);
  assert.equal(adapterResult.providerMetadata.transcriptCaptured, false);
  assert.equal(adapterResult.providerMetadata.transcriptPersistence, false);
  assert.equal(adapterResult.providerMetadata.persistence, "none");
  assert.ok(typeof adapterResult.providerMetadata.executionId === "string");
  assert.match(adapterResult.providerMetadata.executionId, /^stub:/);
  assert.ok(typeof adapterResult.providerMetadata.providerRunId === "string");
  assert.match(adapterResult.providerMetadata.providerRunId, /^stub-run:/);
  assert.equal(adapterResult.providerMetadata.providerStatus, "stub-reserved");
  assert.equal(adapterResult.providerMetadata.executionIdentityKind, "runtime-provider-execution-identity");
  assert.equal(adapterResult.providerMetadata.executionIdentityVersion, "runtime-provider-execution-identity-stub-draft-1");
  assert.equal(adapterResult.providerMetadata.providerSlot, RUNTIME_PROVIDER_ADAPTER_DEFAULT_SLOT);
  assert.equal(adapterResult.transcriptRef, null);
}

/* ───────── Provider-backed full pipeline transcript seam gap documentation ───────── */

/* ───────── Pipeline-level transcript seam same-source gap documentation ───────── */

function testRunRuntimeCaseSkeletonTranscriptSeamSameSourceGapForAllModes() {
  /*
     KNOWN GAP (applies to ALL modes: dry-run, null-runner, provider-backed):

     The runner (runtime-runner.mjs ~line 540) unconditionally creates a fallback
     transcriptRef with available=true via:
       const reportTranscriptRef = result.transcriptRef
         ?? buildRuntimeTranscriptArtifactRef({ available: true, ... });

     But the mapper always emits transcriptAvailability.available=false for all
     non-provider-backed and reserved-seam paths.

     The reporter's normalizeRuntimeCase (runtime-replay-reporter.mjs:344)
     detects this contradiction:
       "Runtime replay report transcript availability must match the single
        upstream transcriptRef source without fallback"

     Root cause: the runner fallback unconditionally assumes available=true,
     ignoring that the adapter returned transcriptRef=null and the mapper
     resolved transcriptAvailability.available=false.

     Suggested fix incision (runtime-runner.mjs):
       const reportTranscriptRef = result.transcriptRef
         ?? buildRuntimeTranscriptArtifactRef({ available: false, ... });

     This test documents that the guard IS working — it correctly throws
     rather than silently producing inconsistent state — for ALL modes.
  */
  const normalizedFixture = createNormalizedFixture();
  const loadedFixture = createLoadedFixture();
  const preflightReport = createPreflightReport("passed");

  for (const mode of ["dry-run", "null-runner", "provider-backed"]) {
    assert.throws(
      () =>
        runRuntimeCaseSkeleton({
          fixtureDir: "/tmp/runtime-contract-fixture",
          loadedFixture,
          normalizedFixture,
          preflightReport,
          options: { mode },
        }),
      /transcript availability must match the single upstream transcriptRef/,
      `${mode}: runRuntimeCaseSkeleton must throw same-source error`,
    );
  }
}

/* ───────── Transcript seam boundary tests via direct contract builders ───────── */

function testTranscriptAvailabilityRefAndExecutionSeamRemainConservativeForAllModes() {
  /*
     Instead of driving through the broken runRuntimeCaseSkeleton pipeline,
     this test verifies the transcript seam boundaries layer-by-layer via
     direct contract builders, proving the individual seam rules are correct
     even when the full pipeline is blocked by the runner fallback gap.
  */
  const normalizedFixture = createNormalizedFixture();
  const loadedFixture = createLoadedFixture();
  const preflightReport = createPreflightReport("passed");
  const sandboxContract = buildRuntimeSandboxBoundaryFromSources({
    normalizedFixture,
    preflightInput: preflightReport,
  });
  const caseRecord = selectRuntimeCase({ normalizedFixture });

  for (const mode of ["dry-run", "null-runner", "provider-backed"]) {
    /* --- LAYER 1: Adapter contract --- */
    const providerSelection = buildRuntimeProviderSelection({
      mode,
      providerSlot: RUNTIME_PROVIDER_ADAPTER_DEFAULT_SLOT,
    });
    const providerAdapterContract = buildRuntimeProviderAdapterContractContext({
      fixtureDir: "/tmp/runtime-contract-fixture",
      loadedFixture,
      normalizedFixture,
      caseRecord,
      boundary: {
        permissions: sandboxContract.permissions,
        toolBoundary: sandboxContract.toolBoundary,
      },
      options: {
        mode,
        providerKey: mode,
        providerSlot: RUNTIME_PROVIDER_ADAPTER_DEFAULT_SLOT,
        providerSelection,
      },
    });

    const adapterResult = providerAdapterContract.buildResult({
      caseId: caseRecord.id,
      status: mode === "null-runner" ? "not-executed" : mode === "provider-backed" ? "error" : "dry-run",
      selection: providerSelection,
      providerMetadata: {
        implementationState:
          mode === "provider-backed" ? "reserved-unimplemented-provider-slot" : "builtin-skeleton-adapter",
        providerBacked: mode === "provider-backed",
        providerKey: mode,
        providerSlot: RUNTIME_PROVIDER_ADAPTER_DEFAULT_SLOT,
      },
    });

    /* Adapter never produces a transcriptRef for non-provider-backed and reserved provider-backed */
    assert.equal(adapterResult.transcriptRef, null, `${mode}: adapterResult.transcriptRef must be null`);

    /* Adapter selection matches mode */
    assert.equal(adapterResult.selection.adapterKey, mode, `${mode}: adapter selection adapterKey`);
    assert.equal(
      adapterResult.selection.providerBacked,
      mode === "provider-backed",
      `${mode}: adapter selection providerBacked`,
    );
    assert.equal(
      adapterResult.selection.implemented,
      mode !== "provider-backed",
      `${mode}: adapter selection implemented`,
    );

    /* Adapter evidence stays conservative */
    assert.equal(adapterResult.evidence.providerEvidenceAvailable, false);
    assert.equal(adapterResult.evidence.transcriptAvailable, false);
    assert.equal(adapterResult.evidence.transcriptCaptured, false);
    assert.equal(adapterResult.evidence.transcriptPersistence, false);

    /* --- LAYER 2: Mapper --- */
    const mapped = mapProviderResultToObservedRuntime({
      adapterResult,
      providerSelection,
      caseContext: caseRecord,
    });

    /* transcriptAvailability stays all-false/none for all modes */
    assert.equal(
      mapped.transcriptAvailability.available,
      false,
      `${mode}: transcriptAvailability.available must be false`,
    );
    assert.equal(mapped.transcriptAvailability.providerManaged, false);
    assert.equal(mapped.transcriptAvailability.handle, null);
    assert.equal(mapped.transcriptAvailability.location, null);
    assert.equal(
      mapped.transcriptAvailability.providerBacked,
      mode === "provider-backed",
      `${mode}: transcriptAvailability.providerBacked matches mode`,
    );
    assert.equal(mapped.transcriptAvailability.transcriptCaptured, false);
    assert.equal(mapped.transcriptAvailability.transcriptPersistence, false);
    assert.equal(mapped.transcriptAvailability.persistence, "none");

    /* providerExecution matches */
    assert.equal(mapped.providerExecution.providerBacked, mode === "provider-backed");
    assert.equal(mapped.providerExecution.transcriptAvailable, false);
    assert.equal(mapped.providerExecution.transcriptCaptured, false);
    assert.equal(mapped.providerExecution.transcriptPersistence, false);
    assert.equal(mapped.providerExecution.transcriptHandle, null);
    assert.equal(mapped.providerExecution.transcriptProviderManaged, false);
    assert.equal(mapped.providerExecution.rawResponseAvailable, false);
    assert.equal(mapped.providerExecution.rawResponseSummary, null);
    assert.equal(mapped.providerExecution.rawResponseHandle, null);

    /* Non-provider-backed: execution identity must be null */
    if (mode !== "provider-backed") {
      assert.equal(mapped.providerExecution.executionId, null);
      assert.equal(mapped.providerExecution.providerRunId, null);
      assert.equal(mapped.providerExecution.providerStatus, null);
    } else {
      /* Provider-backed reserved seam: stub execution identity exposed */
      assert.ok(typeof mapped.providerExecution.executionId === "string");
      assert.match(mapped.providerExecution.executionId, /^stub:/);
      assert.ok(typeof mapped.providerExecution.providerRunId === "string");
      assert.match(mapped.providerExecution.providerRunId, /^stub-run:/);
      assert.equal(mapped.providerExecution.providerStatus, "stub-reserved");
    }

    /* --- LAYER 3: Runner contract buildResult transcriptRef scrubbing --- */
    const runnerResult = buildRuntimeRunnerResult({
      caseId: caseRecord.id,
      status: mapped.status,
      runnerMetadata: {
        providerBacked: mapped.providerExecution.providerBacked,
        executed: false,
        providerCall: false,
      },
      transcriptRef: null,
    });

    assert.equal(runnerResult.transcriptRef, null, `${mode}: runner result transcriptRef must stay null`);

    /* transcriptRef must be rejectable for non-provider-backed with fakes */
    if (mode !== "provider-backed") {
      assert.throws(
        () =>
          buildRuntimeRunnerResult({
            caseId: caseRecord.id,
            status: mapped.status,
            runnerMetadata: {
              providerBacked: false,
              executed: false,
              providerCall: false,
            },
            transcriptRef: { available: true, providerTranscript: true, handle: "fake" },
          }),
        /Provider transcript refs are reserved/i,
        `${mode}: runner must reject providerTranscript for non-provider-backed`,
      );

      assert.throws(
        () =>
          buildRuntimeRunnerResult({
            caseId: caseRecord.id,
            status: mapped.status,
            runnerMetadata: {
              providerBacked: false,
              executed: false,
              providerCall: false,
            },
            transcriptRef: { available: true, providerManaged: true, handle: "fake" },
          }),
        /Provider-managed transcript refs are reserved/i,
        `${mode}: runner must reject providerManaged for non-provider-backed`,
      );
    }

    /* --- LAYER 4: Report contract via buildRuntimeReplayReport with aligned data --- */
    /* Manually construct transcriptRef and transcriptAvailability that ARE same-source */
    const alignedTranscriptRef = {
      kind: RUNTIME_TRANSCRIPT_ARTIFACT_REF_KIND,
      version: RUNTIME_TRANSCRIPT_ARTIFACT_REF_VERSION,
      available: false,
      providerTranscript: false,
      providerManaged: false,
      handle: null,
      location: null,
      persistence: "none",
      note: `aligned ref for ${mode}`,
      artifactId: null,
      caseId: caseRecord.id,
      executionMode: mode,
    };

    const alignedTranscriptAvailability = {
      available: false,
      providerManaged: false,
      handle: null,
      location: null,
      providerBacked: mode === "provider-backed",
      transcriptCaptured: false,
      transcriptPersistence: false,
      persistence: "none",
    };

    /* These aligned inputs should NOT throw the same-source mismatch */
    const report = buildRuntimeReplayReport({
      fixtureDir: "/tmp/runtime-contract-fixture",
      fixture: {
        id: "runtime-contract-fixture",
        version: "0.1.0",
        entry: "skill/SKILL.md",
        profile: "standard",
      },
      runtime: {
        mode,
        providerExecution: mapped.providerExecution,
        transcriptAvailability: alignedTranscriptAvailability,
      },
      cases: [
        {
          id: caseRecord.id,
          type: caseRecord.type,
          status: mapped.status,
          observed: mapped.observed,
          providerExecution: mapped.providerExecution,
          transcriptAvailability: alignedTranscriptAvailability,
          transcriptRef: alignedTranscriptRef,
          failureReason: mapped.failureReason,
        },
      ],
    });

    /* Verify report produced correctly with aligned same-source data */
    assert.equal(report.kind, "runtime-replay-report", `${mode}: report kind`);
    assert.equal(report.cases.length, 1, `${mode}: report has 1 case`);
    assert.equal(report.cases[0].transcriptRef.available, false);
    assert.equal(report.cases[0].transcriptRef.providerTranscript, false);
    assert.equal(report.cases[0].transcriptAvailability.available, false);
    assert.equal(report.cases[0].transcriptAvailability.providerBacked, mode === "provider-backed");
    assert.equal(report.cases[0].transcriptAvailability.providerManaged, false);
    assert.equal(report.cases[0].providerExecution.transcriptHandle, null);
    assert.equal(report.cases[0].providerExecution.transcriptProviderManaged, false);
    assert.equal(report.cases[0].status, mapped.status);
    assert.notEqual(report.cases[0].status, "passed");
  }
}

function testObservedMappingSeamContractAcrossReservedModes() {
  const normalizedFixture = createNormalizedFixture();
  const caseRecord = selectRuntimeCase({ normalizedFixture });

  assert.deepEqual(RUNTIME_OBSERVED_MAPPER_PROVIDER_SELECTION_KEYS, ["dry-run", "null-runner", "provider-backed"]);
  assert.deepEqual(RUNTIME_OBSERVED_MAPPER_ALLOWED_STATUSES, ["blocked", "error", "dry-run", "not-executed"]);

  const seamCases = [
    {
      label: "dry-run",
      adapterResult: {
        caseId: caseRecord.id,
        status: "dry-run",
        providerMetadata: {
          implementationState: "builtin-skeleton-adapter",
          executed: false,
          providerCall: false,
          providerEvidenceAvailable: false,
          transcriptCaptured: false,
          transcriptPersistence: false,
          persistence: "none",
        },
      },
      providerSelection: {
        adapterKey: "dry-run",
        providerKey: "dry-run",
        providerSlot: RUNTIME_PROVIDER_ADAPTER_DEFAULT_SLOT,
        builtin: true,
        implemented: true,
        providerBacked: false,
      },
      expected: {
        status: "dry-run",
        evidence: "not-executed",
        providerBacked: false,
      },
    },
    {
      label: "null-runner",
      adapterResult: {
        caseId: caseRecord.id,
        status: "not-executed",
        providerMetadata: {
          implementationState: "builtin-skeleton-adapter",
          executed: false,
          providerCall: false,
          providerEvidenceAvailable: false,
          transcriptCaptured: false,
          transcriptPersistence: false,
          persistence: "none",
        },
      },
      providerSelection: {
        adapterKey: "null-runner",
        providerKey: "null-runner",
        providerSlot: RUNTIME_PROVIDER_ADAPTER_DEFAULT_SLOT,
        builtin: true,
        implemented: true,
        providerBacked: false,
      },
      expected: {
        status: "not-executed",
        evidence: "not-executed",
        providerBacked: false,
      },
    },
    {
      label: "provider-backed-reserved",
      adapterResult: {
        caseId: caseRecord.id,
        status: "error",
        selection: {
          adapterKey: "provider-backed",
          providerKey: "provider-backed",
          providerSlot: RUNTIME_PROVIDER_ADAPTER_DEFAULT_SLOT,
          builtin: true,
          implemented: false,
          providerBacked: true,
        },
        execution: {
          executed: false,
          providerCall: false,
          executionId: "stub:provider-backed:future-provider-backed-single-case-runtime",
          providerRunId: "stub-run:provider-backed:future-provider-backed-single-case-runtime",
          providerStatus: "stub-reserved",
        },
        evidence: {
          providerEvidenceAvailable: false,
          transcriptAvailable: false,
          transcriptCaptured: false,
          transcriptPersistence: false,
          persistence: "none",
        },
        rawResponse: {
          available: false,
          summary: null,
          handle: null,
        },
        providerMetadata: {
          implementationState: "reserved-unimplemented-provider-slot",
          executed: false,
          providerCall: false,
          providerEvidenceAvailable: false,
          transcriptCaptured: false,
          transcriptPersistence: false,
          persistence: "none",
          executionId: "stub:provider-backed:future-provider-backed-single-case-runtime",
          providerRunId: "stub-run:provider-backed:future-provider-backed-single-case-runtime",
          providerStatus: "stub-reserved",
        },
      },
      providerSelection: {
        adapterKey: "provider-backed",
        providerKey: "provider-backed",
        providerSlot: RUNTIME_PROVIDER_ADAPTER_DEFAULT_SLOT,
        builtin: true,
        implemented: false,
        providerBacked: true,
      },
      expected: {
        status: "error",
        evidence: "provider-slot-reserved",
        providerBacked: true,
      },
    },
    {
      label: "preflight-blocked",
      adapterResult: {
        caseId: caseRecord.id,
        status: "blocked",
        failureReason: {
          code: "RUNTIME_PREFLIGHT_BLOCKED",
          message: "blocked by preflight",
          blockingCheckIds: ["RF-P1-PREFLIGHT-STATIC-BASELINE-PASSED"],
        },
        providerMetadata: {
          implementationState: "preflight-blocked",
          executed: false,
          providerCall: false,
          providerEvidenceAvailable: false,
          transcriptCaptured: false,
          transcriptPersistence: false,
          persistence: "none",
        },
      },
      providerSelection: {
        adapterKey: "dry-run",
        providerKey: "dry-run",
        providerSlot: RUNTIME_PROVIDER_ADAPTER_DEFAULT_SLOT,
        builtin: true,
        implemented: true,
        providerBacked: false,
      },
      expected: {
        status: "blocked",
        evidence: "preflight-blocked",
        providerBacked: false,
      },
    },
  ];

  for (const seamCase of seamCases) {
    const mapped = mapProviderResultToObservedRuntime({
      adapterResult: seamCase.adapterResult,
      providerSelection: seamCase.providerSelection,
      caseContext: caseRecord,
    });

    assert.equal(mapped.contract.kind, "runtime-observed-mapper-output");
    assert.equal(mapped.contract.version, RUNTIME_OBSERVED_MAPPER_VERSION);
    assert.equal(mapped.caseId, caseRecord.id);
    assert.equal(mapped.status, seamCase.expected.status);

    assert.equal(mapped.observed.kind, "runtime-observed-stub");
    assert.equal(mapped.observed.mode, seamCase.providerSelection.adapterKey);
    assert.equal(mapped.observed.evidence, seamCase.expected.evidence);
    assert.equal(mapped.observed.providerCall, false);
    assert.equal(mapped.observed.providerEvidenceAvailable, false);
    assert.equal(mapped.observed.transcriptCaptured, false);
    assert.equal(mapped.observed.persistedEvidenceAvailable, false);
    assert.equal(mapped.observed.sideEffectsPerformed, false);

    assert.deepEqual(Object.keys(mapped.providerExecution).sort(), [
      "adapterKey",
      "builtin",
      "executed",
      "executionId",
      "futureRequiredFields",
      "implementationState",
      "implemented",
      "note",
      "pendingCapabilities",
      "persistence",
      "providerBacked",
      "providerCall",
      "providerEvidenceAvailable",
      "providerKey",
      "providerRunId",
      "providerSlot",
      "providerStatus",
      "rawResponseAvailable",
      "rawResponseHandle",
      "rawResponseSummary",
      "reservedStatusSet",
      "selection",
      "status",
      "transcriptAvailable",
      "transcriptCaptured",
      "transcriptHandle",
      "transcriptPersistence",
      "transcriptProviderManaged",
    ].sort());
    assert.deepEqual(Object.keys(mapped.providerExecution.selection).sort(), [
      "adapterKey",
      "builtin",
      "implemented",
      "kind",
      "providerBacked",
      "providerKey",
      "providerSlot",
      "version",
    ].sort());
    assert.equal(mapped.providerExecution.selection.kind, "runtime-provider-selection");
    assert.equal(mapped.providerExecution.selection.adapterKey, seamCase.providerSelection.adapterKey);
    assert.equal(mapped.providerExecution.selection.providerKey, seamCase.providerSelection.providerKey);
    assert.equal(mapped.providerExecution.selection.providerSlot, seamCase.providerSelection.providerSlot);
    assert.equal(mapped.providerExecution.selection.builtin, seamCase.providerSelection.builtin);
    assert.equal(mapped.providerExecution.selection.implemented, seamCase.providerSelection.implemented);
    assert.equal(mapped.providerExecution.selection.providerBacked, seamCase.providerSelection.providerBacked);
    assert.equal(mapped.providerExecution.adapterKey, seamCase.providerSelection.adapterKey);
    assert.equal(mapped.providerExecution.providerKey, seamCase.providerSelection.providerKey);
    assert.equal(mapped.providerExecution.providerSlot, RUNTIME_PROVIDER_ADAPTER_DEFAULT_SLOT);
    assert.equal(mapped.providerExecution.builtin, true);
    assert.equal(mapped.providerExecution.implemented, seamCase.providerSelection.implemented);
    assert.equal(mapped.providerExecution.providerBacked, seamCase.expected.providerBacked);
    assert.equal(mapped.providerExecution.status, seamCase.expected.status);
    assert.equal(mapped.providerExecution.executed, false);
    assert.equal(mapped.providerExecution.providerCall, false);
    assert.equal(mapped.providerExecution.providerEvidenceAvailable, false);
    assert.equal(mapped.providerExecution.transcriptAvailable, false);
    assert.equal(mapped.providerExecution.transcriptCaptured, false);
    assert.equal(mapped.providerExecution.transcriptPersistence, false);
    assert.equal(mapped.providerExecution.persistence, "none");
    assert.equal(mapped.providerExecution.rawResponseAvailable, false);
    assert.equal(mapped.providerExecution.rawResponseSummary, null);
    assert.equal(mapped.providerExecution.rawResponseHandle, null);
    assert.equal(mapped.providerExecution.transcriptHandle, null);
    assert.equal(mapped.providerExecution.transcriptProviderManaged, false);
    assert.equal(mapped.transcriptAvailability.available, false);
    assert.equal(mapped.transcriptAvailability.providerManaged, false);
    assert.equal(mapped.transcriptAvailability.handle, null);
    assert.equal(mapped.transcriptAvailability.location, null);
    assert.equal(mapped.transcriptAvailability.providerBacked, seamCase.expected.providerBacked);
    assert.equal(mapped.transcriptAvailability.transcriptCaptured, false);
    assert.equal(mapped.transcriptAvailability.transcriptPersistence, false);
    assert.equal(mapped.transcriptAvailability.persistence, "none");

    /* Execution identity: non-provider-backed must be null; provider-backed reserved shows stub */
    if (seamCase.expected.providerBacked === true) {
      assert.ok(typeof mapped.providerExecution.executionId === "string");
      assert.match(mapped.providerExecution.executionId, /^stub:/);
      assert.ok(typeof mapped.providerExecution.providerRunId === "string");
      assert.match(mapped.providerExecution.providerRunId, /^stub-run:/);
      assert.equal(mapped.providerExecution.providerStatus, "stub-reserved");
    } else {
      assert.equal(mapped.providerExecution.executionId, null);
      assert.equal(mapped.providerExecution.providerRunId, null);
      assert.equal(mapped.providerExecution.providerStatus, null);
    }
  }
}

function testRawResponseSummaryAndHandleStayReservedAcrossRuntimeModes() {
  /* KNOWN GAP: runRuntimeCaseSkeleton broken for all modes due to runner fallback transcriptRef mismatch. */
  const normalizedFixture = createNormalizedFixture();
  const loadedFixture = createLoadedFixture();
  const preflightReport = createPreflightReport("passed");

  for (const mode of ["dry-run", "null-runner", "provider-backed"]) {
    assert.throws(
      () =>
        runRuntimeCaseSkeleton({
          fixtureDir: "/tmp/runtime-contract-fixture",
          loadedFixture,
          normalizedFixture,
          preflightReport,
          options: { mode },
        }),
      /transcript availability must match the single upstream transcriptRef/,
    );
  }

  assert.throws(
    () =>
      runRuntimeCaseSkeleton({
        fixtureDir: "/tmp/runtime-contract-fixture",
        loadedFixture,
        normalizedFixture,
        preflightReport: createPreflightReport("failed"),
        options: { mode: "dry-run" },
      }),
    /transcript availability must match the single upstream transcriptRef/,
  );
}

